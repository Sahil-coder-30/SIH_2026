# k8s/secrets.yml.example — PharmaChain Kubernetes Secrets Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# ✅  This file IS committed to Git — it contains only placeholder markers.
# ⚠️  secrets.yml (the real file) is in .gitignore — NEVER commit it.
#
# ── How to use ────────────────────────────────────────────────────────────────
#   1. cp k8s/secrets.yml.example k8s/secrets.yml
#   2. Replace every <PLACEHOLDER> with your real value
#   3. kubectl apply -f k8s/secrets.yml
#
# ── Sections ──────────────────────────────────────────────────────────────────
#   1. database-secret       — MongoDB connection URIs
#   2. auth-secret           — JWT signing keys + service tokens + admin token
#   3. crypto-secret         — AES-256-GCM master key + RSA-4096 PEM key pair
#   4. s3-secret             — AWS S3 credentials for CSV artifact storage
#   5. backend-secret        — Hyperledger Fabric (Spring) backend URL
#
# ── Secret generation commands ────────────────────────────────────────────────
#   JWT / service tokens     : openssl rand -hex 32
#   KEY_ENCRYPTION_SECRET    : openssl rand -hex 32   (must give 64 hex chars)
#   RSA-4096 private key     : openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out private.pem
#   RSA-4096 public key      : openssl rsa -pubout -in private.pem -out public.pem
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. Database Secrets ────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: database-secret
  namespace: default
type: Opaque
stringData:
  MANUFACTURER_MONGO_URI: "<YOUR_MANUFACTURER_MONGODB_URI>"
  SHOPKEEPER_MONGO_URI: "<YOUR_SHOPKEEPER_MONGODB_URI>"

---
# ── 2. Auth & Session Secrets ─────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: auth-secret
  namespace: default
type: Opaque
stringData:
  MANUFACTURER_JWT_SECRET: "<GENERATE_MFR_JWT_SECRET>"
  SHOPKEEPER_JWT_SECRET: "<GENERATE_SHOP_JWT_SECRET>"
  JWT_EXPIRES_IN: "7d"
  SERVICE_TOKEN: "<GENERATE_SHARED_INTERNAL_SERVICE_TOKEN>"
  # Required — guards POST /api/manufacturer/auth/kyc/approve
  # and POST /api/shopkeeper/auth/kyc/approve.
  ADMIN_TOKEN: "<GENERATE_ADMIN_TOKEN>"

---
# ── 3. Cryptographic Vault Secrets ────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: crypto-secret
  namespace: default
type: Opaque
stringData:
  KEY_ENCRYPTION_SECRET: "<GENERATE_64_CHAR_HEX_VIA_OPENSSL_RAND_HEX_32>"
  CORE_RSA_KID: "pharma-core-rs256"
  CORE_RSA_PUBLIC_KEY: |
    -----BEGIN PUBLIC KEY-----
    <PASTE_RSA_4096_PUBLIC_KEY_PEM_HERE>
    -----END PUBLIC KEY-----
  CORE_RSA_PRIVATE_KEY: |
    -----BEGIN PRIVATE KEY-----
    <PASTE_RSA_4096_PRIVATE_KEY_PEM_HERE>
    -----END PRIVATE KEY-----

---
# ── 4. AWS S3 Secrets ─────────────────────────────────────────────────────────
# pharma-core uploads QR CSV files here after every mint.
# Bucket: pharmachain-qr-csvs (ap-south-1)
# IAM perms needed: s3:PutObject, s3:GetObject on the bucket.
apiVersion: v1
kind: Secret
metadata:
  name: s3-secret
  namespace: default
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "<YOUR_AWS_ACCESS_KEY_ID>"
  AWS_SECRET_ACCESS_KEY: "<YOUR_AWS_SECRET_ACCESS_KEY>"
  AWS_REGION: "ap-south-1"
  S3_BUCKET_NAME: "pharmachain-qr-csvs"
  S3_URL_EXPIRY_SECONDS: "604800"

---
# ── 5. Blockchain Backend Secrets ─────────────────────────────────────────────
# pharma-backend runs standalone outside K8s (Spring Boot + Fabric gateway).
# Local dev: http://host.docker.internal:8080
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: default
type: Opaque
stringData:
  PHARMA_BACKEND_URL: "<YOUR_PHARMA_BACKEND_URL>"
  FABRIC_CHANNEL_NAME: "pharmachannel"
  FABRIC_CHAINCODE_NAME: "pharmacontract"
