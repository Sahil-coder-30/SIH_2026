# k8s/secrets.yml.example — Template for Kubernetes Secrets
# 📋 Instructions:
#   1. Copy this file: cp k8s/secrets.yml.example k8s/secrets.yml
#   2. Replace all placeholder values (<GENERATE_...>) with secure secrets
#   3. Set direct MongoDB connection URIs in database-secret
#   4. Set PHARMA_BACKEND_URL to the address of your standalone blockchain backend
#   5. Apply to cluster: kubectl apply -f k8s/secrets.yml
#   ⚠️ NEVER commit k8s/secrets.yml to Git!

# ── 1. Database Secrets (Direct MongoDB URIs) ─────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: database-secret
type: Opaque
stringData:
  MANUFACTURER_MONGO_URI: "mongodb://manufacturer-db-service:27017/manufacturer"
  SHOPKEEPER_MONGO_URI: "mongodb://shopkeeper-db-service:27017/shopkeeper"

---
# ── 2. Authentication & Session Secrets ───────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: auth-secret
type: Opaque
stringData:
  # HS256 JWT secrets for user session tokens & JWKS service authentication
  MANUFACTURER_JWT_SECRET: "<GENERATE_MFR_JWT_SECRET>"
  SHOPKEEPER_JWT_SECRET: "<GENERATE_SHOP_JWT_SECRET>"
  JWT_EXPIRES_IN: "7d"

  # Internal service token fallback
  SERVICE_TOKEN: "<GENERATE_LONG_RANDOM_CLUSTER_SECRET_STRING>"

---
# ── 3. Cryptographic Vault & RSA JWKS Identity Secrets ────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: crypto-secret
type: Opaque
stringData:
  # Master AES-256-GCM encryption secret (MUST be exactly 64 hex characters)
  # Generate with: openssl rand -hex 32
  KEY_ENCRYPTION_SECRET: "<GENERATE_64_CHAR_HEX_STRING_E.G._OPENSSL_RAND_-HEX_32>"
  
  # pharma-core RSA Key ID
  CORE_RSA_KID: "pharma-core-rs256"
  
  # RSA-4096 Public Key (SPKI PEM)
  # Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out private.pem && openssl rsa -pubout -in private.pem -out public.pem
  CORE_RSA_PUBLIC_KEY: |
    -----BEGIN PUBLIC KEY-----
    <PASTE_PHARMA_CORE_RSA_4096_PUBLIC_KEY_PEM_HERE>
    -----END PUBLIC KEY-----

  # RSA-4096 Private Key (PKCS#8 PEM)
  CORE_RSA_PRIVATE_KEY: |
    -----BEGIN PRIVATE KEY-----
    <PASTE_PHARMA_CORE_RSA_4096_PRIVATE_KEY_PEM_HERE>
    -----END PRIVATE KEY-----

---
# ── 4. Independent Standalone Blockchain Backend Secrets ─────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
type: Opaque
stringData:
  # External address of the standalone blockchain backend running outside K8s:
  # - Local development (host machine): http://host.docker.internal:8080
  # - Remote / VM / Staging server: http://<EXTERNAL_IP_OR_HOSTNAME>:8080
  PHARMA_BACKEND_URL: "http://host.docker.internal:8080"
  FABRIC_CHANNEL_NAME: "pharmachannel"
  FABRIC_CHAINCODE_NAME: "pharmacontract"
